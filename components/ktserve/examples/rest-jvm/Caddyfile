{
	admin off
	auto_https disable_redirects
}

https://localhost:{$KTSERVE_REST_TLS_PORT:8443} {
	bind 127.0.0.1
	tls {$KTSERVE_REST_TLS_CERT} {$KTSERVE_REST_TLS_KEY}
	basic_auth {
		{env.KTSERVE_REST_USER} {env.KTSERVE_REST_PASSWORD_HASH}
	}
	reverse_proxy 127.0.0.1:{$KTSERVE_REST_ORIGIN_PORT:8081} {
		header_up X-KtServe-Identity {http.auth.user.id}
		header_up -Authorization
	}
}
